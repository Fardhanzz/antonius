# ==========================================
# ANTONIUS — Environment Variables Template
# ==========================================

# AI Vision & Solver (Gemini API - Milestone 3 & 4)
# Keep private; never expose to client code
GEMINI_API_KEY=

# Optional: Gemini model override (Default: gemini-3.5-flash-lite)
# Supported options: gemini-3.5-flash-lite, gemini-2.5-flash, gemini-2.5-pro
GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# Optional: Gemini solver model override (Default: gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-3.5-flash-lite
GEMINI_SOLVER_MODEL=gemini-2.5-flash

# Optional: Gemini follow-up tutor model override (Default: gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-3.5-flash-lite
GEMINI_FOLLOWUP_MODEL=gemini-2.5-flash

# Optional: Gemini web grounding model override (Default: gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-3.5-flash-lite
GEMINI_GROUNDING_MODEL=gemini-2.5-flash

# Web Search Provider (Milestone 6)
SEARCH_API_KEY=

# Supabase Postgres & Storage (Milestone 7)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
